{
  "name": "bantz-overlay",
  "version": "0.1.0",
  "description": "Bantz Desktop Overlay HUD — transparent terminal-style assistant UI",
  "main": "src/main/main.js",
  "scripts": {
    "copy-assets": "node scripts/copy-assets.js",
    "prestart": "node scripts/copy-assets.js",
    "start": "electron .",
    "predev": "node scripts/copy-assets.js",
    "dev": "NODE_ENV=development electron .",
    "prebuild": "node scripts/copy-assets.js",
    "build": "electron-builder",
    "build:linux": "electron-builder --linux"
  },
  "author": "iclaldogan",
  "license": "MIT",
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.bantz.overlay",
    "productName": "Bantz Overlay",
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "src/renderer/assets",
        "to": "renderer/assets",
        "filter": ["**/*.png", "**/*.webp", "**/*.svg"]
      }
    ],
    "files": [
      "src/**/*",
      "!src/renderer/assets/bantz_no_bg_KEEP_SMILE_CLEAN.png",
      "!src/renderer/assets/bantz_no_bg_KEEP_SMILE_CLEAN@2x.png",
      "!src/renderer/assets/bantz.png"
    ]
  },
  "dependencies": {
    "three": "^0.182.0"
  },
  "overrides": {
    "tar": "^7.5.7"
  }
}
